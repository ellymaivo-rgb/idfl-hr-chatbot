# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Models (change if Google releases newer ones)
CHAT_MODEL=gemini-3.5-flash
EMBED_MODEL=gemini-embedding-001

# Folders with knowledge documents (relative to hr-chatbot/), separated by ";"
DOCS_DIRS=../Internal Policies & Handbooks;../Taxation & Labor Legislation

# Minimum cosine similarity for a chunk to count as relevant (0-1).
# Raise it if the bot answers off-topic questions; lower it if it refuses too often.
MIN_SCORE=0.55
TOP_K=8
PORT=3000
